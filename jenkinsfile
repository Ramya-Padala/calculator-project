pipeline{
    tools{
        nodejs "mynode"
    }
    agent none
    stages{
        stage('Checkout'){
           agent any
            steps{
                git 'https://github.com/Aswin9796/calculator-project-.git'
            }
        }
        stage('build'){
            agent any
            steps{
                sh 'npm install'
                sh 'CI=false npm run build'
            }
        }
        stage('Deploy') {
    steps {
        sh '''
            sudo docker rm -f cal1 || true
            sudo docker run -d \
                --name cal1 \
                -p 3000:3000 \
                calcuimg:latest
        '''
            }
        }
    }
}
