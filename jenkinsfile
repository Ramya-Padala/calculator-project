pipeline {
    agent any

    tools {
        nodejs 'mynode'
    }

    stages {
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build') {
            steps {
                sh 'CI=false npm run build'
            }
        }
        stage('SonarQube Code Analysis') {
                environment {
                    SONAR_SCANNER_HOME = '/var/lib/jenkins/tools/hudson.plugins.sonar.SonarRunnerInstallation/SonarScanner'
                    PATH = "${SONAR_SCANNER_HOME}/bin:${env.PATH}"
                }
            steps {
                echo "Running SonarQube Analysis"
                withSonarQubeEnv('sonar-server') {
                    sh """
                    sonar-scanner \
                        -Dsonar.projectKey=calculator-project \
                        -Dsonar.projectName="calculator-project" \
                        -Dsonar.projectVersion=1.0 \
                        -Dsonar.sources=. 
                        """
                }
            }
        }
        stage('Docker Build') {
            steps {
                sh 'sudo docker build -t calcuimg:latest .'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    sudo docker rm -f cal1 || true

                    sudo docker run -d \
                        --name cal1 \
                        -p 3000:3000 \
                        calcuimg:latest
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    sudo docker ps
                    sudo docker logs --tail 50 cal1
                '''
            }
        }
    }
}
