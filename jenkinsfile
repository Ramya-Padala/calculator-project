pipeline {
    agent any

    tools {
        nodejs 'mynode'
    }

    stages {
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build') {
            steps {
                sh 'CI=false npm run build'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'sudo docker build -t calcuimg:latest .'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    sudo docker rm -f cal1 || true

                    sudo docker run -d \
                        --name cal1 \
                        -p 3000:3000 \
                        calcuimg:latest
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    sudo docker ps
                    sudo docker logs --tail 50 cal1
                '''
            }
        }
    }
}
